[Desktop Entry]
Type=Application
Version=1.5
Name=Navigator
GenericName=File Manager
GenericName[tr]=Dosya Yöneticisi
Comment=Fast keyboard-driven file manager
Comment[tr]=Hızlı, klavye odaklı dosya yöneticisi
