# Optional Phase 10 dependencies: GIO (GVfs mounts/URIs) and libarchive (archive browse/extract).
# Both default to AUTO: enabled when found via pkg-config, disabled cleanly otherwise so
# Navigator builds and runs without GVfs or libarchive.

find_package(PkgConfig QUIET)

set(NAVIGATOR_GVFS "AUTO" CACHE STRING "Enable GIO/GVfs backend (AUTO, ON, OFF)")
set_property(CACHE NAVIGATOR_GVFS PROPERTY STRINGS AUTO ON OFF)

set(NAVIGATOR_HAVE_GVFS 0)
if(NOT NAVIGATOR_GVFS STREQUAL "OFF")
    if(PkgConfig_FOUND)
        pkg_check_modules(NAVIGATOR_GIO QUIET IMPORTED_TARGET gio-2.0)
    endif()
    if(TARGET PkgConfig::NAVIGATOR_GIO)
        set(NAVIGATOR_HAVE_GVFS 1)
        add_library(navigator_gio INTERFACE)
        target_link_libraries(navigator_gio INTERFACE PkgConfig::NAVIGATOR_GIO)
        add_library(Navigator::GIO ALIAS navigator_gio)
        message(STATUS "Navigator: GIO/GVfs ${NAVIGATOR_GIO_VERSION} (pkg-config)")
    elseif(NAVIGATOR_GVFS STREQUAL "ON")
        message(FATAL_ERROR "NAVIGATOR_GVFS=ON but gio-2.0 was not found via pkg-config.")
    else()
        message(STATUS "Navigator: GIO/GVfs not found — building without GVfs support")
    endif()
else()
    message(STATUS "Navigator: GIO/GVfs disabled (NAVIGATOR_GVFS=OFF)")
endif()

set(NAVIGATOR_LIBARCHIVE "AUTO" CACHE STRING "Enable libarchive browsing/extraction (AUTO, ON, OFF)")
set_property(CACHE NAVIGATOR_LIBARCHIVE PROPERTY STRINGS AUTO ON OFF)

set(NAVIGATOR_HAVE_LIBARCHIVE 0)
if(NOT NAVIGATOR_LIBARCHIVE STREQUAL "OFF")
    if(PkgConfig_FOUND)
        pkg_check_modules(NAVIGATOR_ARCHIVE QUIET IMPORTED_TARGET libarchive)
    endif()
    if(TARGET PkgConfig::NAVIGATOR_ARCHIVE)
        set(NAVIGATOR_HAVE_LIBARCHIVE 1)
        add_library(navigator_libarchive INTERFACE)
        target_link_libraries(navigator_libarchive INTERFACE PkgConfig::NAVIGATOR_ARCHIVE)
        add_library(Navigator::LibArchive ALIAS navigator_libarchive)
        message(STATUS "Navigator: libarchive ${NAVIGATOR_ARCHIVE_VERSION} (pkg-config)")
    elseif(NAVIGATOR_LIBARCHIVE STREQUAL "ON")
        message(FATAL_ERROR "NAVIGATOR_LIBARCHIVE=ON but libarchive was not found via pkg-config.")
    else()
        message(STATUS "Navigator: libarchive not found — building without archive browsing")
    endif()
else()
    message(STATUS "Navigator: libarchive disabled (NAVIGATOR_LIBARCHIVE=OFF)")
endif()
